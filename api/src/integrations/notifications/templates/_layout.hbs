<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{{title}}</title>
  </head>
  <body style="margin:0;padding:0;background-color:#faf9f5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#faf9f5;">
      <tr>
        <td align="center" style="padding:40px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:520px;">
            <tr>
              <td style="padding-bottom:32px;font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:26px;letter-spacing:-0.5px;color:#141413;">
                Reelty
              </td>
            </tr>
            <tr>
              <td style="font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif;font-size:34px;line-height:1.15;letter-spacing:-0.5px;color:#141413;padding-bottom:16px;">
                {{title}}
              </td>
            </tr>
            <tr>
              <td style="font-family:Inter,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#3d3d3a;">
                {{> @partial-block}}
              </td>
            </tr>
            <tr>
              <td style="padding-top:40px;border-top:1px solid #e6dfd8;font-family:Inter,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;line-height:1.5;color:#8e8b82;">
                You are receiving this because of activity on your Reelty account.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
