{{#> layout title="Reset your password"}}
<p style="margin:0 0 16px;">We received a request to reset the password for your account. Choose a new one with the button below.</p>
<p style="margin:24px 0;">
  <a href="{{url}}" style="display:inline-block;background-color:#cc785c;color:#ffffff;text-decoration:none;font-weight:500;font-size:15px;padding:13px 24px;border-radius:8px;">Choose a new password</a>
</p>
<p style="margin:0 0 16px;">The link works for 1 hour and only once. If you did not ask for this, you can ignore this email and your password stays the same.</p>
<p style="margin:0;font-size:13px;color:#6c6a64;word-break:break-all;">Button not working? Paste this into your browser:<br />{{url}}</p>
{{/layout}}
