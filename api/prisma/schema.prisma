// Reelty data model — see docs/Product_Specification.md §8
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum SourceType {
  website
  airbnb
  upload
}

// Coarse, user-facing project status (spec §2)
enum ProjectStatus {
  DRAFT
  FETCHING
  READY
  QUEUED
  CREATING
  COMPLETED
  FAILED
}

// Resumable render state machine (spec §5.3)
enum RenderStep {
  QUEUED
  PREPARING
  GENERATING
  ASSEMBLING
  UPLOADING
  COMPLETED
  FAILED
  BLOCKED_NO_CREDITS
}

enum WatermarkStatus {
  none
  processing
  done
  failed
}

enum ClipStatus {
  none
  submitted
  completed
  failed
}

enum RoomType {
  AUTO
  EXTERIOR
  LIVING_ROOM
  KITCHEN
  BEDROOM
  BATHROOM
  TERRACE_VIEW
  OTHER
}

enum ConsentType {
  rights
  watermark
}

enum LedgerKind {
  video
  video_refund
  dewatermark
  scrape
  higgsfield
}

// User credit balance movements (credit_transactions.kind)
enum CreditTxKind {
  signup_grant
  purchase
  video_charge
  video_refund
  purchase_refund
  admin_adjustment
}

enum PurchaseStatus {
  pending
  paid
  failed
  expired
  refunded
  partially_refunded
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password_hash       String
  role                AuthRole  @default(USER)
  email_verified_at   DateTime?
  credit_balance      Int       @default(0) // cached sum of credit_transactions, changed in the same tx
  stripe_customer_id  String?   @unique
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  refresh_tokens            RefreshToken[]
  password_reset_tokens     PasswordResetToken[]
  email_verification_tokens EmailVerificationToken[]
  projects                  Project[]
  consents                  Consent[]
  usage_ledger              UsageLedger[]
  credit_transactions       CreditTransaction[]
  credit_purchases          CreditPurchase[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  family_id  String
  expires_at DateTime
  revoked_at DateTime?
  user_agent String?
  ip         String?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([family_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("password_reset_tokens")
}

model Project {
  id          String        @id @default(uuid())
  user_id     String
  source_type SourceType
  source_url  String?
  status      ProjectStatus @default(DRAFT)
  render_step RenderStep?
  partial     Boolean       @default(false)

  // human-readable failure info (never raw provider errors)
  failure_reason String?
  failure_code   String? // e.g. scrape_empty, provider_timeout, too_few_clips, ffmpeg_error, blocked_no_credits
  scrape_error   String?

  title         String   @default("")
  subtitle      String?
  location_line String?
  closing_line  String?
  music_enabled Boolean  @default(true)
  soundtrack_id String   @default("ambient") // one of SOUNDTRACKS (shared/constants/soundtracks.constants.ts)

  rights_attested_at DateTime?
  submitted_at       DateTime?
  completed_at       DateTime?
  render_started_at  DateTime? // start of GENERATING, used for the 20 min hard cap
  quota_charged      Boolean   @default(false) // exactly-once flag for the credit charge / refund
  credits_charged    Int       @default(0) // credits taken at submit (tier + add-ons); a refund gives these back

  video_gcs_path    String?
  poster_gcs_path   String?
  duration_seconds  Float?
  clips_total       Int      @default(0)
  clips_done        Int      @default(0)
  skipped_image_ids String[] @default([])

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  images  Image[]
  consents Consent[]
  job_events  JobEvent[]
  usage_ledger UsageLedger[]
  credit_transactions CreditTransaction[]

  @@index([user_id, created_at(sort: Desc)])
  @@index([status])
  @@map("projects")
}

model Image {
  id         String @id @default(uuid())
  project_id String
  position   Int

  gcs_original_path  String?
  gcs_processed_path String?
  gcs_thumb_path     String?
  width              Int?
  height             Int?
  bytes              Int?
  content_hash       String?
  source_url         String?

  room_type     RoomType        @default(AUTO)
  use_processed Boolean         @default(false)
  wm_status     WatermarkStatus @default(none)
  wm_attempts   Int             @default(0)
  removed       Boolean         @default(false)
  // true after the upload is confirmed + validated (magic bytes, size) and thumb created
  ready         Boolean         @default(false)

  higgsfield_media_id String?
  clip_job_id         String?
  clip_status         ClipStatus @default(none)
  clip_result_url     String?
  clip_gcs_path       String?

  created_at DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, position])
  @@index([project_id, content_hash])
  @@map("images")
}

model Consent {
  id          String      @id @default(uuid())
  user_id     String
  project_id  String
  type        ConsentType
  accepted_at DateTime    @default(now())
  ip          String?

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([project_id, type])
  @@map("consents")
}

model JobEvent {
  id            String   @id @default(uuid())
  project_id    String
  job_name      String
  bullmq_job_id String?
  step          String?
  status        String
  message       String?
  created_at    DateTime @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id, created_at])
  @@map("job_events")
}

model UsageLedger {
  id             String     @id @default(uuid())
  user_id        String
  project_id     String?
  kind           LedgerKind
  quota_units    Int        @default(0) // +1 charge, -1 refund (kind video / video_refund)
  provider_units Float? // legacy mixed unit (credits / dollars / images by kind); read credits + cost_usd instead
  credits        Float? // provider credits consumed by this row (null when the provider bills in USD, e.g. Apify)
  cost_usd       Float? // our price in USD for this row, stored at write time so later price changes do not rewrite history
  cost_estimated Boolean    @default(false) // true when cost_usd comes from app_config prices instead of a provider-reported figure
  note           String?
  created_at     DateTime   @default(now())

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([project_id])
  @@map("usage_ledger")
}

// Video price tiers by clip count, managed by admins. Tiers are contiguous (no gaps or overlaps) and set
// the allowed photos per video (lowest min_clips..highest max_clips); exactly one is_default tier
// (used by the purchase slider: videos -> credits).
model CreditTier {
  id         String   @id @default(uuid())
  name       String
  min_clips  Int
  max_clips  Int
  credits    Int
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("credit_tiers")
}

// Every change to a user's credit balance (signed). balance_after = users.credit_balance after this row.
model CreditTransaction {
  id            String       @id @default(uuid())
  user_id       String
  kind          CreditTxKind
  credits       Int
  balance_after Int
  project_id    String?
  purchase_id   String?
  note          String?
  created_at    DateTime     @default(now())

  user     User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project  Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)
  purchase CreditPurchase? @relation(fields: [purchase_id], references: [id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([project_id])
  @@map("credit_transactions")
}

// One Stripe Checkout purchase of credits. Money is in integer cents; EUR is the charge currency and
// USD figures use the usd_per_eur rate snapshotted at payment time.
model CreditPurchase {
  id              String         @id @default(uuid())
  user_id         String
  status          PurchaseStatus @default(pending)
  credits         Int
  videos_selected Int? // slider value (informational)
  credits_per_eur Float // app_config snapshot used to price this purchase
  currency        String         @default("eur")

  amount_eur_cents     Int // total charged
  stripe_fee_eur_cents Int? // Stripe processing fee
  net_eur_cents        Int? // amount - fee
  stripe_fee_pct       Float? // fee / amount * 100
  usd_per_eur          Float? // FX snapshot for the USD columns
  amount_usd_cents     Int?
  stripe_fee_usd_cents Int?
  net_usd_cents        Int?
  refunded_eur_cents   Int            @default(0)
  refunded_credits     Int            @default(0)

  stripe_checkout_session_id    String? @unique
  stripe_payment_intent_id      String?
  stripe_charge_id              String?
  stripe_balance_transaction_id String?
  payment_method_type           String?
  card_brand                    String?
  card_country                  String?
  receipt_url                   String?

  paid_at     DateTime?
  refunded_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([user_id, created_at])
  @@index([status, created_at])
  @@index([stripe_charge_id])
  @@map("credit_purchases")
}

// Volume pricing: a purchase that costs at least min_eur at this tier's rate gets credits_per_eur credits for
// each euro instead of the base rate (app_config billing.credits_per_eur). The best tier reached applies.
model CreditRateTier {
  id              String   @id @default(uuid())
  min_eur         Int      @unique
  credits_per_eur Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("credit_rate_tiers")
}

// Operator-editable numeric settings: provider prices for services that do not report their own cost,
// and fallbacks. Keys are defined in modules/app-config/app-config.constants.ts.
model AppConfig {
  key         String   @id
  value       Float
  unit        String
  description String?
  updated_at  DateTime @updatedAt

  @@map("app_config")
}

// Singleton row (id = "global") for the global kill switch / provider circuit breakers
model SystemFlag {
  id                  String   @id @default("global")
  renders_enabled     Boolean  @default(true)
  dewatermark_enabled Boolean  @default(true)
  scrape_enabled      Boolean  @default(true)
  updated_at          DateTime @updatedAt

  @@map("system_flags")
}
