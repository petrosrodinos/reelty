# ENVIRONMENT (local | development | staging | production)
NODE_ENV=staging
PORT=3000

# CLIENT URLS
# APP_URL is used to build email links (${APP_URL}/verify?token=..., ${APP_URL}/reset?token=...)
APP_URL=http://localhost:3001
LANDING_URL=http://localhost:3001
# Comma separated CORS allow-list (cookies are sent cross-origin, so no wildcards)
CORS_URLS=http://localhost:3001
API_URL=http://localhost:3000/api
# Optional: cookie Domain attribute (e.g. .reelty.app) when app and api are on sibling subdomains
COOKIE_DOMAIN=

# POSTGRES (required in staging/production)
DATABASE_URL=

# REDIS (required in staging/production; must use maxmemory-policy noeviction)
REDIS_URL=

# AUTH (JWT_SECRET: min 32 chars outside local)
JWT_SECRET=

# GOOGLE CLOUD STORAGE (private bucket)
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_CREDENTIALS_JSON_BASE64=

# EMAIL (Resend; empty key = emails are logged to the console)
RESEND_API_KEY=

# PROVIDERS (all optional, features degrade with clear error codes)
APIFY_TOKEN=
DEWATERMARK_API_KEY=
HIGGSFIELD_API_KEY=

# FFMPEG (workers; defaults to ffmpeg-static / ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_FONT_PATH=

# BULL BOARD (/admin/queues, basic auth)
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
