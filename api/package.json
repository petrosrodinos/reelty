{
  "name": "reelty-api",
  "version": "0.0.1",
  "description": "Reelty API: turn property photos into a cinematic walkthrough video",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:local": "npx dotenv -e .env.local -- nest start --watch",
    "start:dev": "npx dotenv -e .env.development -- nest start --watch",
    "start:staging": "npx dotenv -e .env.staging -- nest start --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "prisma generate",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate dev",
    "migrate:local": "dotenv -e .env.local -- npx prisma migrate dev",
    "migrate:staging": "dotenv -e .env.staging -- npx prisma migrate deploy",
    "migrate:prod": "npx prisma migrate deploy",
    "studio:local": "npx dotenv -e .env.local -- npx prisma studio",
    "studio:staging": "npx dotenv -e .env.staging -- npx prisma studio",
    "gcs:cors": "ts-node -r tsconfig-paths/register src/scripts/set-gcs-cors.ts",
    "gcs:cors:staging": "dotenv -e .env.staging -- ts-node -r tsconfig-paths/register src/scripts/set-gcs-cors.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@bull-board/api": "^6.16.2",
    "@bull-board/express": "^6.16.2",
    "@google-cloud/storage": "^7.18.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "apify-client": "^2.25.0",
    "archiver": "^8.0.0",
    "argon2": "^0.45.1",
    "axios": "^1.10.0",
    "bullmq": "^5.66.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.7.0",
    "luxon": "^3.7.1",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.16.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.17",
    "@types/ffprobe-static": "^2.0.3",
    "@types/jest": "^29.5.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
